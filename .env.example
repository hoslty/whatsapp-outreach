# Caminho do dataset de contatos, em formato de tabela (JSON), relativo à raiz do projeto
DATA_PATH=./data/contatos.json

# Caminho do arquivo de controle de envios (estado persistido)
CONTROL_FILE_PATH=./data/control.json

# Janelas de horário comercial (formato 24h HH:mm-HH:mm, separadas por vírgula)
BUSINESS_HOURS_WINDOWS=09:00-11:30,14:00-16:30

# Intervalo aleatório entre envios, em minutos
MIN_INTERVAL_MINUTES=1
MAX_INTERVAL_MINUTES=2

# Pasta onde os logs serão salvos
LOG_DIR=./logs
